#rename this file to .env and set relevant parameters

PROJECT_NAME="Restaurant Ordering"

#for local host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pastry_shop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

TURNSTILE_SECRET_KEY= YOUR_TURNSTILE_SECRET_KEY

# ============================================
# SUPABASE STORAGE (persistent product images)
# ============================================
# Leave blank for local dev to fall back to local disk.
# In production set all three so uploads survive deploys/restarts.
#   SUPABASE_URL: https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_KEY: the service_role key (Project Settings → API)
#   Create a PUBLIC bucket whose name matches SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=products

# Required. Generate a strong random value: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Notification System Configuration Template

# ============================================
# EMAIL NOTIFICATIONS
# ============================================
SHOP_OWNER_EMAIL=admin@restaurant.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@restaurant.com

# ============================================
# SMS/WHATSAPP/VOICE NOTIFICATIONS (Twilio)
# ============================================
# Get these from https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token

# For SMS notifications
TWILIO_PHONE_NUMBER=+1234567890

# For WhatsApp notifications
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================
# NOTIFICATION FEATURE FLAGS
# ============================================
ENABLE_SMS_NOTIFICATIONS=False
ENABLE_WHATSAPP_NOTIFICATIONS=False
ENABLE_VOICE_NOTIFICATIONS=False
ENABLE_EMAIL_NOTIFICATIONS=True

# Retry settings for failed notifications
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=5

